#include "filesystem.h"
#include <cstring>
#include <iostream>
#include <stdexcept>

FileSystem fs;

// 全局变量：当前所在目录 inode（默认根目录 0）
int current_dir_inode = 0;

FileSystem::DirEntry::DirEntry()
    : inode_id(-1), is_valid(false)
{
    memset(filename, 0, sizeof(filename));
}

FileSystem::DirEntry::DirEntry(const std::string &name, int ino)
    : inode_id(ino), is_valid(true)
{
    strncpy(filename, name.c_str(), sizeof(filename) - 1);
}

FileSystem::FileSystem()
{
    try
    {
        _init_fs();
    }
    catch (...)
    {
        std::cerr << "[文件系统] 初始化失败\n";
        exit(1);
    }
}

void FileSystem::_init_fs()
{
    iNode root_inode;
    if (!disk_manager.read_inode(ROOT_INODE_ID, root_inode))
    {
        int root_ino = disk_manager.allocate_inode();
        if (root_ino != ROOT_INODE_ID)
            throw std::runtime_error("根目录创建失败");

        root_inode.i_num = ROOT_INODE_ID;
        root_inode.i_mode = 0;
        root_inode.i_size = 0;
        root_inode.is_readonly = false;
        memset(root_inode.direct_blocks, -1, sizeof(root_inode.direct_blocks));

        int b = disk_manager.allocate_block();
        root_inode.direct_blocks[0] = b;
        root_inode.i_size = BLOCK_SIZE;

        disk_manager.write_inode(ROOT_INODE_ID, root_inode);
        char buf[BLOCK_SIZE] = {0};
        disk_manager.write_data_block(b, buf);
    }
}

int FileSystem::_find_file_in_dir(int dir_inode_id, const std::string &filename)
{
    iNode ino;
    if (!disk_manager.read_inode(dir_inode_id, ino) || ino.i_mode != 0)
        return -1;

    for (int i = 0; i < 10 && ino.direct_blocks[i] != -1; ++i)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(ino.direct_blocks[i], buf);
        DirEntry *e = (DirEntry *)buf;
        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (e[j].is_valid && filename == e[j].filename)
                return e[j].inode_id;
        }
    }
    return -1;
}

bool FileSystem::_add_file_to_dir(int dir_inode_id, const std::string &filename, int file_inode_id)
{
    iNode ino;
    if (!disk_manager.read_inode(dir_inode_id, ino) || ino.i_mode != 0)
        return false;

    for (int i = 0; i < 10; ++i)
    {
        if (ino.direct_blocks[i] == -1)
        {
            int b = disk_manager.allocate_block();
            ino.direct_blocks[i] = b;
            ino.i_size += BLOCK_SIZE;
            disk_manager.write_inode(dir_inode_id, ino);
            char buf[BLOCK_SIZE] = {0};
            disk_manager.write_data_block(b, buf);
        }

        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(ino.direct_blocks[i], buf);
        DirEntry *e = (DirEntry *)buf;
        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (!e[j].is_valid)
            {
                e[j] = DirEntry(filename, file_inode_id);
                disk_manager.write_data_block(ino.direct_blocks[i], buf);
                return true;
            }
        }
    }
    return false;
}

bool FileSystem::_remove_file_from_dir(int dir_inode_id, const std::string &filename)
{
    iNode ino;
    if (!disk_manager.read_inode(dir_inode_id, ino) || ino.i_mode != 0)
        return false;

    for (int i = 0; i < 10 && ino.direct_blocks[i] != -1; ++i)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(ino.direct_blocks[i], buf);
        DirEntry *e = (DirEntry *)buf;
        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (e[j].is_valid && filename == e[j].filename)
            {
                e[j].is_valid = false;
                disk_manager.write_data_block(ino.direct_blocks[i], buf);
                return true;
            }
        }
    }
    return false;
}

void FileSystem::_free_file_blocks(int inode_id)
{
    iNode ino;
    if (!disk_manager.read_inode(inode_id, ino))
        return;
    for (int i = 0; i < 10; ++i)
    {
        if (ino.direct_blocks[i] != -1)
        {
            disk_manager.free_block(ino.direct_blocks[i]);
            ino.direct_blocks[i] = -1;
        }
    }
    disk_manager.write_inode(inode_id, ino);
}

int FileSystem::create_file(const std::string &filename, bool is_dir)
{
    if (_find_file_in_dir(ROOT_INODE_ID, filename) != -1)
    {
        std::cerr << "[文件系统] 文件已存在\n";
        return -1;
    }

    int ino = disk_manager.allocate_inode();
    if (ino == -1)
        return -1;

    iNode node;
    node.i_num = ino;
    node.i_mode = is_dir ? 0 : 1;
    node.i_size = 0;
    node.is_readonly = false;
    memset(node.direct_blocks, -1, sizeof(node.direct_blocks));

    if (is_dir)
    {
        int b = disk_manager.allocate_block();
        node.direct_blocks[0] = b;
        node.i_size = BLOCK_SIZE;
        char buf[BLOCK_SIZE] = {0};
        disk_manager.write_data_block(b, buf);
    }

    if (!disk_manager.write_inode(ino, node))
    {
        disk_manager.free_inode(ino);
        return -1;
    }

    if (!_add_file_to_dir(ROOT_INODE_ID, filename, ino))
    {
        _free_file_blocks(ino);
        disk_manager.free_inode(ino);
        return -1;
    }

    std::cout << "[文件系统] 创建成功：" << filename << "\n";
    return ino;
}

bool FileSystem::delete_file(const std::string &filename)
{
    int ino = _find_file_in_dir(ROOT_INODE_ID, filename);
    if (ino == -1)
        return false;

    iNode node;
    disk_manager.read_inode(ino, node);
    if (node.is_readonly)
        return false;

    if (node.i_mode == 0)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(node.direct_blocks[0], buf);
        DirEntry *e = (DirEntry *)buf;
        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (e[j].is_valid)
            {
                std::cerr << "[文件系统] 目录非空\n";
                return false;
            }
        }
    }

    _free_file_blocks(ino);
    _remove_file_from_dir(ROOT_INODE_ID, filename);
    disk_manager.free_inode(ino);
    std::cout << "[文件系统] 删除成功：" << filename << "\n";
    return true;
}

int FileSystem::write_file(const std::string &filename, const std::string &data, int offset)
{
    int ino = _find_file_in_dir(ROOT_INODE_ID, filename);
    if (ino == -1)
        return -1;

    iNode node;
    disk_manager.read_inode(ino, node);
    if (node.is_readonly || node.i_mode == 0)
        return -1;

    int len = data.size();
    int written = 0;
    int bid = offset / BLOCK_SIZE;
    int off = offset % BLOCK_SIZE;

    while (written < len && bid < 10)
    {
        if (node.direct_blocks[bid] == -1)
        {
            int b = disk_manager.allocate_block();
            node.direct_blocks[bid] = b;
        }

        char buf[BLOCK_SIZE] = {0};
        disk_manager.read_data_block(node.direct_blocks[bid], buf);
        int wl = std::min(len - written, BLOCK_SIZE - off);
        memcpy(buf + off, data.c_str() + written, wl);
        disk_manager.write_data_block(node.direct_blocks[bid], buf);

        written += wl;
        off = 0;
        bid++;
    }

    node.i_size = std::max(node.i_size, offset + written);
    disk_manager.write_inode(ino, node);
    return written;
}

std::string FileSystem::read_file(const std::string &filename, int offset, int len)
{
    int ino = _find_file_in_dir(ROOT_INODE_ID, filename);
    if (ino == -1)
        return "";

    iNode node;
    disk_manager.read_inode(ino, node);
    if (node.i_mode == 0)
        return "";

    if (len == -1)
        len = node.i_size - offset;
    std::string s;
    int bid = offset / BLOCK_SIZE;
    int off = offset % BLOCK_SIZE;
    int r = 0;

    while (r < len && bid < 10 && node.direct_blocks[bid] != -1)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(node.direct_blocks[bid], buf);
        int rl = std::min(len - r, BLOCK_SIZE - off);
        s.append(buf + off, rl);
        r += rl;
        bid++;
        off = 0;
    }
    return s;
}

bool FileSystem::set_file_permission(const std::string &filename, bool readonly)
{
    int ino = _find_file_in_dir(ROOT_INODE_ID, filename);
    if (ino == -1)
        return false;
    iNode node;
    disk_manager.read_inode(ino, node);
    node.is_readonly = readonly;
    disk_manager.write_inode(ino, node);
    return true;
}

bool FileSystem::get_file_info(const std::string &filename, iNode &out)
{
    int ino = _find_file_in_dir(ROOT_INODE_ID, filename);
    if (ino == -1)
        return false;
    return disk_manager.read_inode(ino, out);
}

// 1. ls：列出当前目录内容
void FileSystem::ls()
{
    iNode dir_inode;
    disk_manager.read_inode(current_dir_inode, dir_inode);

    printf("\n[目录内容]\n");
    for (int i = 0; i < 10 && dir_inode.direct_blocks[i] != -1; ++i)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(dir_inode.direct_blocks[i], buf);
        DirEntry *entries = (DirEntry *)buf;

        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (entries[j].is_valid)
            {
                iNode node;
                disk_manager.read_inode(entries[j].inode_id, node);
                const char *type = (node.i_mode == 0) ? "[目录]" : "[文件]";
                printf("%s %s\n", type, entries[j].filename);
            }
        }
    }
    printf("\n");
}

// 2. pwd：打印当前路径（简易版）
void FileSystem::pwd()
{
    printf("当前路径: /\n");
}

// 3. cd：切换目录（进入子目录 / 返回上一级）
bool FileSystem::cd(const std::string &dirname)
{
    if (dirname == "..")
    {
        current_dir_inode = 0; // 简化：直接回根目录
        printf("已返回根目录\n");
        return true;
    }

    int ino = _find_file_in_dir(current_dir_inode, dirname);
    if (ino == -1)
    {
        printf("cd 失败：目录不存在\n");
        return false;
    }

    iNode node;
    disk_manager.read_inode(ino, node);
    if (node.i_mode != 0)
    {
        printf("cd 失败：不是目录\n");
        return false;
    }

    current_dir_inode = ino;
    printf("已进入目录：%s\n", dirname.c_str());
    return true;
}

// 4. rename：重命名文件/目录
bool FileSystem::rename(const std::string &oldname, const std::string &newname)
{
    int old_ino = _find_file_in_dir(current_dir_inode, oldname);
    if (old_ino == -1)
    {
        printf("rename 失败：原文件不存在\n");
        return false;
    }

    if (_find_file_in_dir(current_dir_inode, newname) != -1)
    {
        printf("rename 失败：新名称已存在\n");
        return false;
    }

    // 找到目录项并改名
    iNode dir_inode;
    disk_manager.read_inode(current_dir_inode, dir_inode);

    for (int i = 0; i < 10 && dir_inode.direct_blocks[i] != -1; ++i)
    {
        char buf[BLOCK_SIZE];
        disk_manager.read_data_block(dir_inode.direct_blocks[i], buf);
        DirEntry *entries = (DirEntry *)buf;

        for (int j = 0; j < BLOCK_SIZE / sizeof(DirEntry); ++j)
        {
            if (entries[j].is_valid && entries[j].inode_id == old_ino)
            {
                strncpy(entries[j].filename, newname.c_str(), 31);
                disk_manager.write_data_block(dir_inode.direct_blocks[i], buf);
                printf("重命名成功：%s -> %s\n", oldname.c_str(), newname.c_str());
                return true;
            }
        }
    }
    return false;
}